      <aliases enabled='yes' />
      <column caption='Filtre période' datatype='boolean' name='[Calculation_1473408857202693]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Paramètre 1473408854364161] = &quot;Toutes&quot; OR STR([year_number]) = [Parameters].[Paramètre 1473408854364161]' />
      </column>
      <column caption='Catégorie affichée' datatype='string' name='[Calculation_1473408857305094]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([product_category_name]) OR TRIM([product_category_name]) = &quot;&quot; THEN &quot;Catégorie inconnue&quot; ELSE [product_category_name] END' />
      </column>
      <column caption='Panier moyen' datatype='real' name='[Calculation_1473408857407495]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_price]) / SUM([nb_orders])' />
      </column>
      <column caption='Taux d&apos;annulation' datatype='real' name='[Calculation_1473408857505800]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nb_orders_canceled]) / SUM([nb_orders_statut_connu])' />
      </column>
      <column caption='Mois' datatype='date' name='[Calculation_1473408857972745]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='MAKEDATE([year_number], [month_number], 1)' />
      </column>
      <column caption='Part du total' datatype='real' name='[Calculation_1473408863084554]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_price]) / MAX({ FIXED : SUM([total_price]) })' />
      </column>
      <column caption='Écart au panier global' datatype='real' name='[Calculation_1473408863215627]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1473408857407495] - MAX({ FIXED : SUM([total_price]) / SUM([nb_orders]) })' />
      </column>
      <column caption='fact_ventes_categorie.csv' datatype='table' name='[__tableau_internal_object_id__].[fact_ventes_categorie.csv_ECBDA0623B8E4583868A93D0066B6399]' role='measure' type='quantitative' />
      <column aggregation='Sum' datatype='integer' name='[month_number]' role='dimension' type='ordinal' />
      <column aggregation='Sum' datatype='integer' name='[year_number]' role='dimension' type='ordinal' />
