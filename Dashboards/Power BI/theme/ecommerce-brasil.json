{
  "name": "E-commerce Brasil",
  "dataColors": [
    "#FFC800",
    "#2FD063",
    "#4D8DFF",
    "#FF7A45",
    "#3CC8B4",
    "#8FA3C4",
    "#B5E36B",
    "#E0A800"
  ],
  "background": "#0E1E3F",
  "foreground": "#EAF0FA",
