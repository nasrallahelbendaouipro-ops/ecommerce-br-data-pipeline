table _Mesures
	lineageTag: 42ea66ad-d2da-4529-8e4b-8c1076c1dda4

	measure 'Commandes livrées' = COUNTROWS ( fact_expeditions )
		formatString: #,0
		lineageTag: 2ee68365-03ac-456c-82d6-74f6361905d7

	measure 'Taux de retard' =
			
			DIVIDE (
			    CALCULATE ( COUNTROWS ( fact_expeditions ), fact_expeditions[is_late] = TRUE () ),
			    COUNTROWS ( fact_expeditions )
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 416ca07e-4d08-4154-b885-23c0438a7360

	measure 'Délai moyen (jours)' = AVERAGE ( fact_expeditions[delivery_days] )
		formatString: 0.0
		lineageTag: 0661f287-d611-4b42-ae2f-5b38b78b23a9

	measure 'Coût de port moyen' = AVERAGE ( fact_expeditions[shipping_charges] )
		formatString: #,0.00
		lineageTag: 5538aed4-5c17-4111-8da4-8a0f1ec46e26

	measure 'Commandes en cours' = COUNTROWS ( fact_commandes_en_cours )
		formatString: #,0
		lineageTag: 7c1d3f52-8a64-4be0-9d27-31e5a0c4b6f1

	measure 'Délai moyen par achat' = CALCULATE ( AVERAGE ( fact_expeditions[delivery_days] ), USERELATIONSHIP ( fact_expeditions[purchase_date], dim_date[date_day] ) )
		formatString: 0.0
		lineageTag: b2e94a07-5d1c-4c8f-a6b3-9e07d2f14c58

	measure 'Livrées par achat' = CALCULATE ( COUNTROWS ( fact_expeditions ), USERELATIONSHIP ( fact_expeditions[purchase_date], dim_date[date_day] ) )
		formatString: #,0
		lineageTag: e3a58c91-2f4b-4d07-8b16-5c9d0a7e1f42

	measure 'Vendeurs actifs' = DISTINCTCOUNT ( fact_expeditions[seller_id] )
		formatString: #,0
		lineageTag: 4f6b2d18-93ae-4c75-b0d1-7a2e58c3f9b6

	measure 'Vendeurs à risque' = CALCULATE ( DISTINCTCOUNT ( fact_expeditions[seller_id] ), int_taux_retard_vendeur[is_vendeur_a_risque] = TRUE () )
		formatString: #,0
		lineageTag: 8d1e7a43-5c29-4b86-a3f0-2b9c64d7e150

	measure 'Ancienneté moyenne (jours)' = AVERAGE ( fact_commandes_en_cours[days_since_purchase] )
		formatString: #,0
		lineageTag: 1a9c5e72-d4b8-47f3-8e06-6f3b0c82a9d4

	measure 'Ancienneté max (jours)' = MAX ( fact_commandes_en_cours[days_since_purchase] )
		formatString: #,0
		lineageTag: 63b0f8d9-2e57-4a1c-9d84-c07a3e51b2f8

	measure 'Date de référence' = MAX ( fact_commandes_en_cours[reference_date] )
		formatString: dd/mm/yyyy
		lineageTag: a7e24c06-8b13-4d95-b5f2-9c1d70e8a346

	measure 'Commandes à risque élevé' = CALCULATE ( COUNTROWS ( fact_commandes_en_cours ), fact_commandes_en_cours[niveau_risque] = "élevé" )
		formatString: #,0
		lineageTag: 1ef110a5-0f74-481f-b84b-58c995867f50

	measure 'Commandes à risque modéré' = CALCULATE ( COUNTROWS ( fact_commandes_en_cours ), fact_commandes_en_cours[niveau_risque] = "modéré" )
		formatString: #,0
		lineageTag: 0c13c24d-48c4-4797-be9b-405bde3dcfd3

	measure 'Commandes à risque indéterminé' = CALCULATE ( COUNTROWS ( fact_commandes_en_cours ), fact_commandes_en_cours[niveau_risque] = "indéterminé" )
		formatString: #,0
		lineageTag: bc8fa750-65ea-47b4-81f1-2cfdebe00665

	measure 'Part à risque élevé ou modéré' = DIVIDE ( [Commandes à risque élevé] + [Commandes à risque modéré], [Commandes en cours] )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: c3ef8554-675c-4a74-9a84-06c19c20203f

	column 'Colonne 1'
		dataType: string
		isHidden
		lineageTag: faee3e22-9d0e-43d8-ae9d-68275a4f1355
		summarizeBy: none
		sourceColumn: Colonne 1

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition _Mesures = m
		mode: import
		source =
				let
				  Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"Colonne 1" = _t])
				in
				  Source

	annotation PBI_ResultType = Table

